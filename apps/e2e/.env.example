# Cypress runtime config (apps/e2e)
#
# All variables are read by Cypress as env vars. The CYPRESS_ prefix is
# automatically stripped — the suite reads them as Cypress.env('...').
# Locally, copy this file to apps/e2e/.env or export the vars in your shell.
# In CI, configure them as GitHub Actions Variables (not Secrets — these are
# documented staging accounts, not sensitive production credentials).

# Where the Cypress runner points the browser. Default targets the local
# pnpm dev frontend on :3000; override to staging in CI.
CYPRESS_BASE_URL=http://localhost:3000

# Pre-seeded admin (P1: only admin is required). Phase 2 adds the rest of
# the role matrix and a second business for multi-tenant tests.
CYPRESS_USER_ADMIN_EMAIL=admin@lacocinadekai.com
CYPRESS_USER_ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Phase 2 — Cypress fixture accounts. Provisioned by:
#   pnpm --filter @kaipos/backend db:seed-cypress
#
# Two tenants (cypress-biz-a, cypress-biz-b), one user per role per tenant,
# plus one global super_admin. Naming: CYPRESS_USER_<ROLE>_<TENANT>_*
# ---------------------------------------------------------------------------

# cypress-biz-a — primary tenant for products / rbac suites.
CYPRESS_USER_ADMIN_A_EMAIL=cypress-admin-a@cypress.test
CYPRESS_USER_ADMIN_A_PASSWORD=cypress-admin-pass-1
CYPRESS_USER_MANAGER_A_EMAIL=cypress-manager-a@cypress.test
CYPRESS_USER_MANAGER_A_PASSWORD=cypress-manager-pass-1
CYPRESS_USER_SUPERVISOR_A_EMAIL=cypress-supervisor-a@cypress.test
CYPRESS_USER_SUPERVISOR_A_PASSWORD=cypress-supervisor-pass-1
CYPRESS_USER_CASHIER_A_EMAIL=cypress-cashier-a@cypress.test
CYPRESS_USER_CASHIER_A_PASSWORD=cypress-cashier-pass-1
CYPRESS_USER_WAITER_A_EMAIL=cypress-waiter-a@cypress.test
CYPRESS_USER_WAITER_A_PASSWORD=cypress-waiter-pass-1
CYPRESS_USER_KITCHEN_A_EMAIL=cypress-kitchen-a@cypress.test
CYPRESS_USER_KITCHEN_A_PASSWORD=cypress-kitchen-pass-1

# cypress-biz-b — second tenant for multi-tenant scoping suite.
CYPRESS_USER_ADMIN_B_EMAIL=cypress-admin-b@cypress.test
CYPRESS_USER_ADMIN_B_PASSWORD=cypress-admin-pass-1
CYPRESS_USER_MANAGER_B_EMAIL=cypress-manager-b@cypress.test
CYPRESS_USER_MANAGER_B_PASSWORD=cypress-manager-pass-1
CYPRESS_USER_SUPERVISOR_B_EMAIL=cypress-supervisor-b@cypress.test
CYPRESS_USER_SUPERVISOR_B_PASSWORD=cypress-supervisor-pass-1
CYPRESS_USER_CASHIER_B_EMAIL=cypress-cashier-b@cypress.test
CYPRESS_USER_CASHIER_B_PASSWORD=cypress-cashier-pass-1
CYPRESS_USER_WAITER_B_EMAIL=cypress-waiter-b@cypress.test
CYPRESS_USER_WAITER_B_PASSWORD=cypress-waiter-pass-1
CYPRESS_USER_KITCHEN_B_EMAIL=cypress-kitchen-b@cypress.test
CYPRESS_USER_KITCHEN_B_PASSWORD=cypress-kitchen-pass-1

# Global super_admin (no tenant suffix — spans all businesses).
CYPRESS_USER_SUPER_ADMIN_EMAIL=cypress-super-admin@cypress.test
CYPRESS_USER_SUPER_ADMIN_PASSWORD=cypress-super-admin-pass-1
